# ── Chroma core ─────────────────────────────────────────────────
# Persist the embedded database to the Railway volume.
# The official image's /config.yaml sets persist_path: /data.
IS_PERSISTENT=TRUE
# Disable anonymous product telemetry.
ANONYMIZED_TELEMETRY=FALSE

# ── Railway platform ──────────────────────────────────────────────
# Chroma listens on port 8000 via its baked-in /config.yaml.
PORT=8000
