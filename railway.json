{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "IMAGE",
    "image": "ghcr.io/chroma-core/chroma:1.5.9"
  },
  "deploy": {
    "healthcheckPath": "/api/v2/heartbeat",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "volumes": [
    {
      "name": "chroma-data",
      "mountPath": "/data"
    }
  ]
}
